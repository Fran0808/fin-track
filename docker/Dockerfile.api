# Build the dashboard, then package it with the Spring Boot API.
FROM node:24-bookworm-slim AS dashboard

WORKDIR /dashboard
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
ARG VITE_ANDROID_APK_URL
RUN npm run build

# Stage 1: Build JAR artifact with Maven
FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder

WORKDIR /build

# Cache Maven dependencies layer
COPY api/pom.xml .
RUN mvn dependency:go-offline -B

# Copy source code and build production package
COPY api/src ./src
COPY --from=dashboard /dashboard/dist/ ./src/main/resources/static/
RUN mvn clean package -DskipTests

# Stage 2: Minimal Production Runtime
FROM eclipse-temurin:21-jre-alpine AS runtime
ENV TZ=America/Lima
ENV JAVA_TOOL_OPTIONS="-Duser.timezone=America/Lima -XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError"

# Run container with a dedicated non-root user for security
RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

WORKDIR /app

# Copy executable jar from builder stage
COPY --from=builder /build/target/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-Djava.security.egd=file:/dev/./urandom", "-jar", "app.jar"]
