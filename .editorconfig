# More info: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Web Frontend (React 19 / TypeScript / Vite / CSS)
[*.{js,jsx,ts,tsx,css,html}]
indent_size = 2

# Configuration & Data interchange formats
[*.{json,yaml,yml,toml}]
indent_size = 2

# Maven POM files
[pom.xml]
indent_size = 2

# Kotlin Gradle build scripts
[*.gradle.kts]
indent_size = 4

# Markdown documentation (preserve trailing whitespace for soft line breaks)
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Windows batch and powershell scripts
[*.{bat,cmd,ps1}]
end_of_line = crlf
