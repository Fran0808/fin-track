# ==============================================================================
# Copy this file to .env and configure values according to your environment.
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_db
DB_USER=postgres
# Use the existing password when reusing an initialized database volume.
DB_PASSWORD=

# Backend API Configuration
SERVER_PORT=8080
API_PORT=8080
# Set the backend URL reachable from the phone; Android builds use this value too.
# Local example: http://192.168.1.50:8080 (use the PC's current LAN address).
APP_SERVER_PUBLIC_URL=http://localhost:8080
# For a physical Android device, replace localhost above with your LAN IP.
SPRING_PROFILES_ACTIVE=dev

# Database Web Management UI (Adminer container)
ADMINER_PORT=8081

# The frontend runs locally with Vite on port 5173.
# Its development proxy expects the API on localhost:8080.

# Legacy IMAP configuration (not used by authenticated ingestion)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SYNC_BATCH_SIZE=20
# Gmail page size, 1-500. Synchronization visits every matching page.

# Background Email Scheduler (Optional, set to true to enable periodic sync)
GMAIL_SYNC_ENABLED=false
GMAIL_SYNC_FIXED_DELAY_MS=60000

# Google OAuth2 & Gmail REST API Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_SUCCESS_URL=http://localhost:5173?auth=google_connected
FRONTEND_ERROR_URL=http://localhost:5173?auth=google_error

# Security & JWT Token Authentication
# Set a private random value of at least 32 bytes.
JWT_SECRET=
JWT_EXPIRATION_MS=604800000

# Production: see docs/development/deployment.md before enabling.
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_JDBC_URL=jdbc:postgresql://database-host:5432/fintrack
# CORS_ALLOWED_ORIGINS=https://your-domain.example
# APP_BUSINESS_ZONE=America/Lima
# DB_POOL_SIZE=5
# PORT=8080
# Override APP_SERVER_PUBLIC_URL, GOOGLE_REDIRECT_URI and both FRONTEND_* URLs
# above with HTTPS URLs on the same public origin. Keep real secrets private.
